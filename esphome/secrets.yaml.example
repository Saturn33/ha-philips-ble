# Copy to secrets.yaml next to your node YAML and fill in. Never commit secrets.yaml.

# Your 2.4 GHz Wi-Fi network.
wifi_ssid: "MyNetwork"
wifi_password: "wifi-password"

# Encrypts the Home Assistant API and over-the-air updates: 32 random bytes in base64.
# Generate one with:
#   python3 -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# Home Assistant asks for the same key when you add the board.
api_key: "REPLACE_WITH_BASE64_KEY="

# Password of the fallback access point the board opens when it cannot join Wi-Fi.
# At least 8 characters (WPA2).
fallback_password: "fallback-ap-password"
