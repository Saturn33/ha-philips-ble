# Copy to tools/deploy.env (git-ignored) and fill in. Used by tools/deploy_dev.sh.

# SSH login of the HA SSH add-on ("Advanced SSH & Web Terminal" or "Terminal & SSH").
# Use the IP address if your machine cannot resolve .local names (WSL).
HA_SSH="root@homeassistant.local"
HA_SSH_PORT=22

# Optional: restart through the HA API instead of "ha core restart" over SSH.
# Long-lived access token: your HA profile → Security → Long-lived access tokens.
HA_URL="http://homeassistant.local:8123"
HA_TOKEN=""

# Optional: HA configuration folder as seen over SSH (default /config).
# HA_CONFIG=/config
